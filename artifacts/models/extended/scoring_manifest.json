  "config": {
    "train_end": "2018-06-01",
    "validation_end": "2018-12-01",
    "seed": 42,
    "injection_rate": 0.06,
    "sensitivity_rate": 0.015,
    "review_fraction": 0.05,
    "minimum_peer_count": 4,
    "preprocessing_clip": false,
    "signed_log1p": true,
    "demo_incentives": {
      "target_history_months": 3,
      "target_growth": 0.03,
      "cold_start_target": 100000.0,
      "base_incentive": 250.0,
      "attainment_component": 750.0,
      "attainment_cap": 2.0,
      "accelerator_threshold": 1.0,
      "accelerator_amount": 500.0,
      "adjustment": 0.0,
      "formulas": {
        "simulated_target_sales": "maximum(historical_target * (1 + target_growth), 1)",
        "simulated_target_attainment_pct": "100 * maximum(total_sales, 0) / simulated_target_sales",
        "simulated_expected_incentive": "base_incentive + attainment_component * minimum(simulated_target_attainment_pct / 100, attainment_cap) + accelerator_amount * maximum(simulated_target_attainment_pct / 100 - accelerator_threshold, 0)",
        "simulated_adjustment": "adjustment",
        "simulated_actual_payout": "simulated_expected_incentive + simulated_adjustment",
        "simulated_payout_delta": "simulated_actual_payout - simulated_expected_incentive",
        "simulated_payout_delta_pct": "100 * simulated_payout_delta / maximum(abs(simulated_expected_incentive), 1)",
        "simulated_payout_to_sales_ratio": "simulated_actual_payout / maximum(abs(total_sales), 1)"
      }
    },
